# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会被提交。
# 全部配置项说明见 docs/05-deployment-ops.md。

# 调用鉴权（默认开启，必须配置；多个密钥用逗号分隔）
# 自己设定即可，建议用随机串：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 调用方在请求头 X-API-Key 里带同一个值；平台侧也填这个值。
RPR_API_KEYS=change-me

# 产物与临时目录：目录不必预先创建，服务会自动建（含多级父目录）。
# 本地 Windows / Linux / 容器各举一例，按环境选一行：
RPR_ARTIFACT_DIR=D:/rpr/artifacts
RPR_RENDER_TMP_DIR=D:/rpr/tmp
# RPR_ARTIFACT_DIR=/data/rpr/artifacts
# RPR_RENDER_TMP_DIR=/tmp/rpr
# 相对路径（如 ./artifacts）也能用，但取决于启动时的工作目录，容器不挂卷时重建即丢，
# 因此服务器上建议用绝对路径并挂载数据卷：-v /srv/rpr/artifacts:/data/rpr/artifacts

# 对外基地址：决定返回给调用方的 file_url 前缀，必须是平台能访问到的地址
# 本地：http://127.0.0.1:8000；服务器：http://服务器IP:8000 或 https://你的域名
RPR_PUBLIC_BASE_URL=http://127.0.0.1:8000

# 常用可调项（留默认值即可）
# RPR_AUTH_ENABLED=true
# RPR_RATE_LIMIT_RPM=60
# RPR_RATE_LIMIT_BURST=10
# RPR_MAX_CONCURRENT_RENDERS=4
# RPR_MAX_QUEUE_SIZE=8
# RPR_RENDER_TIMEOUT_MS=20000
# RPR_MAX_PAGES=5
# RPR_ARTIFACT_TTL_SECONDS=3600
# 日志格式：本地用 console 便于阅读；服务器建议 json（默认值），便于采集与检索
# RPR_LOG_FORMAT=json
