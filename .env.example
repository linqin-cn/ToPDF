# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会被提交。
# 全部配置项说明见 docs/05-deployment-ops.md。

# 调用鉴权（默认开启，必须配置；多个密钥用逗号分隔）
RPR_API_KEYS=change-me

# 产物与临时目录（Windows 建议用正斜杠或双反斜杠）
RPR_ARTIFACT_DIR=D:/data/rpr/artifacts
RPR_RENDER_TMP_DIR=D:/data/rpr/tmp

# 对外基地址：决定返回给调用方的 file_url 前缀，必须是平台能访问到的地址
RPR_PUBLIC_BASE_URL=http://127.0.0.1:8000

# 常用可调项（留默认值即可）
# RPR_AUTH_ENABLED=true
# RPR_RATE_LIMIT_RPM=60
# RPR_RATE_LIMIT_BURST=10
# RPR_MAX_CONCURRENT_RENDERS=4
# RPR_MAX_QUEUE_SIZE=8
# RPR_RENDER_TIMEOUT_MS=20000
# RPR_MAX_PAGES=5
# RPR_ARTIFACT_TTL_SECONDS=3600
# RPR_LOG_FORMAT=json
