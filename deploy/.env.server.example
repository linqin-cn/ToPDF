# 复制为 deploy/.env.server 后修改；该文件包含密钥，不要提交到仓库。

# 调用口令：自己生成一串随机值，平台侧 X-API-Key 填同一个
RPR_API_KEYS=change-me

# 容器内路径（不是宿主机路径；宿主机目录通过 compose 的 volumes 映射）
RPR_ARTIFACT_DIR=/data/artifacts
RPR_RENDER_TMP_DIR=/tmp/rpr

# 必须改成调用方能访问到的地址：直连用 http://服务器IP:8000，走 Nginx 用域名
RPR_PUBLIC_BASE_URL=http://服务器IP:8000

RPR_LOG_FORMAT=json
RPR_AUTH_ENABLED=true
